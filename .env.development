# =============================================================================
# ServiceFlow AI - Development Environment
# =============================================================================
# Used when NODE_ENV=development
# =============================================================================

# Database & Auth (Supabase)
SUPABASE_URL=https://demo-project.supabase.co
SUPABASE_ANON_KEY=sb_demo_anon_key
SUPABASE_SERVICE_ROLE_KEY=sb_demo_service_role_key

# AI Providers
GROQ_API_KEY=gsk_demo_key
OPENAI_API_KEY=sk-demo-key

# WhatsApp (Meta)
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321098765
WHATSAPP_ACCESS_TOKEN=EAADemo1234567890ABCDEFGHIJKLMNOPQRSTUVWXYZ
WHATSAPP_VERIFY_TOKEN=serviceflow_verify_token

# Email (Resend)
RESEND_API_KEY=re_demo_key
RESEND_FROM_EMAIL=noreply@serviceflow.local

# Monitoring (Sentry)
SENTRY_DSN=https://demo@sentry.io/123456
SENTRY_AUTH_TOKEN=sntrys_demo_token

# Analytics (PostHog)
POSTHOG_API_KEY=phc_demo_key
POSTHOG_HOST=https://app.posthog.com

# Redis & Queue (Upstash)
UPSTASH_REDIS_REST_URL=https://demo-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXx_demo_token

# Security
JWT_SECRET=super-secret-jwt-key-for-development
WEBHOOK_SECRET=webhook-secret-for-development

# App Configuration
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty
