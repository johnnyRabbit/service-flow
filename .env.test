# =============================================================================
# ServiceFlow AI - Test Environment
# =============================================================================
# Used when running tests
# =============================================================================

NODE_ENV=test

# Database & Auth (Supabase) - Test instance
SUPABASE_URL=https://test-project.supabase.co
SUPABASE_ANON_KEY=sb_test_anon_key
SUPABASE_SERVICE_ROLE_KEY=sb_test_service_role_key

# AI Providers - Mock keys for testing
GROQ_API_KEY=gsk_test_key
OPENAI_API_KEY=sk-test-key

# WhatsApp (Meta) - Test credentials
WHATSAPP_PHONE_NUMBER_ID=test_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=test_business_account_id
WHATSAPP_ACCESS_TOKEN=test_access_token
WHATSAPP_VERIFY_TOKEN=test_verify_token

# Email (Resend) - Test mode
RESEND_API_KEY=re_test_key
RESEND_FROM_EMAIL=test@serviceflow.local

# Monitoring (Sentry) - Disabled in tests
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Analytics (PostHog) - Disabled in tests
POSTHOG_API_KEY=
POSTHOG_HOST=

# Redis & Queue (Upstash) - Test instance
UPSTASH_REDIS_REST_URL=https://test-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=test_token

# Security
JWT_SECRET=test-jwt-secret-key-for-testing-only
WEBHOOK_SECRET=test-webhook-secret

# App Configuration
PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# Rate Limiting - Disabled in tests
RATE_LIMIT_WINDOW_MS=0
RATE_LIMIT_MAX_REQUESTS=0

# Logging
LOG_LEVEL=error
LOG_FORMAT=json
